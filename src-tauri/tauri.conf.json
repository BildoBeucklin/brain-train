{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gedächtnisstunde",
  "mainBinaryName": "Gedaechtnisstunde",
  "version": "0.1.0",
  "identifier": "de.rossmann-it.gedaechtnisstunde",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gedächtnisstunde",
        "fullscreen": true,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
      "devCsp": "default-src 'self' http://localhost:5173; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data: http://localhost:5173; connect-src 'self' ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rossmann IT Solutions",
    "category": "Education",
    "shortDescription": "Gedächtnistraining für Gruppen",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ]
      }
    }
  }
}
